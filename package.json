{
  "name": "senzy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @senzy/web --filter @senzy/mobile dev",
    "dev:api": "dotnet watch run --project api-server/Senzy.Api.csproj --launch-profile http",
    "dev:web": "pnpm --filter @senzy/web dev",
    "dev:mobile": "pnpm --filter @senzy/mobile dev",
    "check": "pnpm -r --if-present check && dotnet build api-server/Senzy.Api.csproj",
    "test": "pnpm -r --if-present test"
  }
}
